    "profitReliefMax": 2000
  },
  "prepayment": {
    "method": "share-of-profit",
    "bps": 2000,
    "note": "Modelo 130: each quarter, 20% of the net profit since 1 January, minus the earlier quarters' payments (by the 20th of April, July and October, and 30 January). The annual return (June) settles the rest."
  },
  "notes": [
    "Rates named regional_* are not VAT: IGIC applies in the Canary Islands (7% general, 3% reduced) instead of IVA; Ceuta and Melilla apply IPSI.",
    "The income-tax prepayment of modelo 130 is 20% of the quarter's net profit (income minus deductible expenses). Kyros reserves 20% of the taxable base of each payment, which is never less than what is due; the surplus is released after the due date.",
    "Rule packs are information, not tax advice. The user confirms the percentages; the vault enforces what the user chose."
  ],
