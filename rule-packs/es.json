  "enforcement": {
    "level": "strict",
    "facts": [
      "Late filing without a request: 1% surcharge plus 1% per full month of delay, 15% plus late-payment interest after 12 months (art. 27 LGT)",
      "If the AEAT finds the shortfall first: penalties of 50% to 150% of the unpaid tax (art. 191 LGT), plus interest"
    ],
    "source": {
      "title": "Ley General Tributaria, art. 27 (iberley, consolidated text)",
      "url": "https://iberley.es/legislacion/articulo-27-ley-general-tributaria",
      "checked": "2026-10-16"
    }
  },
  "residence": {
    "basis": "worldwide",
    "tests": [
      "More than 183 days in Spain in the calendar year (sporadic absences count unless residence elsewhere is proven), or the main centre of business or economic interests in Spain, or spouse and minor children living in Spain"
    ],
    "days": 183,
    "window": "calendar-year",
    "regimes": [
      {
        "name": "Beckham regime (impatriados)",
        "summary": "24% on Spanish-source income up to EUR 600,000 for 6 years for new residents, including entrepreneurs and remote workers who qualify since the Startups Law"
      },
      {
        "name": "Tax havens",
        "summary": "Spanish nationals who move to a listed tax haven stay resident for that year and the next four"
      }
    ],
    "source": {
      "title": "PwC Worldwide Tax Summaries: Spain, residence",
      "url": "https://taxsummaries.pwc.com/spain/individual/residence"
    },
    "inclusive": false
  },
