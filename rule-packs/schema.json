{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arturete58-sys/kyros2.0/rule-packs/schema.json",
  "title": "Kyros rule pack",
  "description": "Per-country tax rules that suggest a vault's split rule and fiscal calendar. The vault contract enforces percentages and dates; it does not compute taxes.",
  "type": "object",
  "required": [
    "id",
    "country",
    "name",
    "version",
    "currency",
    "presets",
    "calendar"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the rates were last checked against the sources"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "vatName": {
      "type": "string",
      "description": "Local name of the consumption tax (VAT, GST, IVA, ...)"
    },
    "vatRates": {
      "type": "array",
      "description": "Consumption-tax rate tables with the date each applies from; the table in force on a date is the latest enacted one starting on or before it",
      "items": {
        "$ref": "#/$defs/vatTable"
      }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "vatBps",
          "buckets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string"
          },
          "vatBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "buckets": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "name",
                "bps"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]{1,32}$",
                  "not": {
                    "const": "vat"
                  }
                },
                "bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "vatRate": {
            "type": "string",
            "description": "Name of the rate in vatRates this preset charges; the rule follows the table's dates"
          },
          "covers": {
            "type": "array",
            "items": {
              "enum": [
                "incomeTax",
                "social"
              ]
            },
            "uniqueItems": true,
            "description": "What the buckets reserve for, used by the reserve check (default: income tax)"
          },
          "estimate": {
            "$ref": "#/$defs/estimate",
            "description": "Overrides the pack's estimate for this preset"
          },
          "precision": {
            "enum": [
              "exact",
              "exact-on-profit",
              "estimate",
              "none"
            ],
            "description": "Overrides the computed precision of the reserve check"
          },
          "calendar": {
            "type": "object",
            "description": "Overrides parts of the pack's calendar for this preset",
            "properties": {
              "period": {
                "enum": [
                  "Month",
                  "Quarter",
                  "Year",
                  "Months2",
                  "Months4",
                  "Months6"
                ],
                "description": "How often the vault books reserves: the VAT filing period"
              },
              "fiscalYearStart": {
                "type": "string",
                "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
              },
              "vat": {
                "$ref": "#/$defs/due"
              },
              "income": {
                "$ref": "#/$defs/due"
              },
              "buckets": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/due"
                }
              },
              "prepayments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "date",
                    "what"
                  ],
                  "properties": {
                    "date": {
                      "type": "string",
                      "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                    },
                    "what": {
                      "type": "string"
                    }
                  }
                }
              },
              "note": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "url"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "estimate": {
      "$ref": "#/$defs/estimate"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "official": {
            "type": "boolean",
            "description": "Published by the tax authority, the legislator or another public body"
          },
          "checked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date the figures were last compared with this source"
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "description": "Regions with their own income tax (US states), added to the estimate when the user picks one",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/estimateItem"
            }
          },
          "note": {
            "type": "string"
          },
          "replaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of national estimate items this region's items replace"
          }
        }
      }
    },
    "prepayment": {
      "type": "object",
      "required": [
        "method",
        "bps",
        "note"
      ],
      "properties": {
        "method": {
          "enum": [
            "prior-year",
            "share-of-profit"
          ]
        },
        "bps": {
          "$ref": "#/$defs/bps"
        },
        "above": {
          "type": "object",
          "required": [
            "income",
            "bps"
          ],
          "properties": {
            "income": {
              "type": "number"
            },
            "bps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000
            }
          }
        },
        "note": {
          "type": "string"
        }
      },
      "description": "How the law sets income-tax prepayments objectively (prior-year tax or a share of profit)"
    },
    "residence": {
      "type": "object",
      "required": [
        "basis",
        "tests"
      ],
      "description": "Who is tax resident and on what income",
      "properties": {
        "basis": {
          "enum": [
            "worldwide",
            "territorial",
            "remittance",
            "none"
          ]
        },
        "days": {
          "type": "integer"
        },
        "window": {
          "type": "string"
        },
        "inclusive": {
          "type": "boolean"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regimes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "summary"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            }
          }
        },
        "citizenshipBased": {
          "type": "boolean"
        },
        "source": {
          "type": "object"
        }
      }
    },
    "enforcement": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "strict",
            "standard",
            "lenient"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object"
        }
      },
      "description": "How strictly late or short payment is penalised; sets the safety margin"
    },
    "calendar": {
      "$ref": "#/$defs/calendar",
      "description": "When each tax falls due, from the official deadlines"
    }
  },
  "$defs": {
    "bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "vatTable": {
      "type": "object",
      "required": [
        "from",
        "rates"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "rates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/bps"
          }
        },
        "proposed": {
          "type": "boolean",
          "description": "Announced or proposed, not yet law"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "bracket": {
      "type": "array",
      "prefixItems": [
        {
          "type": [
            "number",
            "null"
          ]
        },
        {
          "$ref": "#/$defs/bps"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "[upTo, bps]; null = no upper limit"
    },
    "estimate": {
      "type": "object",
      "required": [
        "year",
        "items"
      ],
      "description": "Simplified annual tax estimate for the reserve check",
      "properties": {
        "year": {
          "type": "integer"
        },
        "taxableShareBps": {
          "$ref": "#/$defs/bps",
          "description": "Presumptive regimes: taxable profit as a share of revenue"
        },
        "socialDeductible": {
          "type": "boolean",
          "description": "Social contributions are deducted from the taxable profit before income tax"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/estimateItem"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "socialDeductibleBps": {
          "$ref": "#/$defs/bps",
          "description": "Only this share of social contributions is deductible (US: half of self-employment tax)"
        },
        "profitReliefBps": {
          "$ref": "#/$defs/bps",
          "description": "Flat deduction from taxable profit as a share of it"
        },
        "profitReliefMax": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "estimateItem": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "brackets"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "incomeTax",
            "social"
          ]
        },
        "basis": {
          "enum": [
            "taxable",
            "revenue"
          ]
        },
        "mode": {
          "enum": [
            "marginal",
            "flat"
          ]
        },
        "brackets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bracket"
          }
        },
        "credit": {
          "type": "number",
          "minimum": 0
        },
        "surchargeBps": {
          "$ref": "#/$defs/bps"
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "minRevenue": {
          "type": "number",
          "minimum": 0
        },
        "zeroUpTo": {
          "type": "number",
          "minimum": 0
        },
        "reliefBps": {
          "$ref": "#/$defs/bps",
          "description": "Share of the basis relieved before the brackets apply (e.g. a profit exemption)"
        },
        "scope": {
          "enum": [
            "central"
          ],
          "description": "The national (central government) scale, compared with the OECD Tax Database"
        }
      }
    },
    "due": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "days"
          ],
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 800
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "monthsAfter",
            "day"
          ],
          "properties": {
            "monthsAfter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "except": {
              "type": "object",
              "required": [
                "periodEndMonth",
                "monthsAfter",
                "day"
              ],
              "properties": {
                "periodEndMonth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "monthsAfter": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 24
                },
                "day": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "date",
            "yearsAfter"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
            },
            "yearsAfter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "When a tax falls due: days after the period; a day of a month after it (with one exception by the period's last month); or a date after the fiscal year starts. After the end of that day (UTC) what is left can be released."
    },
    "calendar": {
      "type": "object",
      "required": [
        "period",
        "income",
        "note"
      ],
      "properties": {
        "period": {
          "enum": [
            "Month",
            "Quarter",
            "Year",
            "Months2",
            "Months4",
            "Months6"
          ],
          "description": "How often the vault books reserves: the VAT filing period"
        },
        "fiscalYearStart": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "vat": {
          "$ref": "#/$defs/due"
        },
        "income": {
          "$ref": "#/$defs/due"
        },
        "buckets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/due"
          }
        },
        "prepayments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "what"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
              },
              "what": {
                "type": "string"
              }
            }
          }
        },
        "note": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
